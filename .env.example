# Local synthetic demo only. Compose keeps PostgreSQL off the host network.
PROOFLINE_PORT=8000
APP_ORIGIN=http://127.0.0.1:8000
POSTGRES_PASSWORD=proofline_local_only
LIVE_ENABLED=false
# Live is opt-in and requires a separately approved API model and call budget.
# Empty values deliberately provide no working API access.
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_OUTPUT_TOKENS=4096
DEV_ORIGINS=[]
VALIDATION_PROFILE=proofline-validation-v1

# For host-based development against the dedicated test instance, set explicitly:
# DATABASE_URL=postgresql+psycopg://proofline:proofline_test@127.0.0.1:15432/proofline_test
# PROOFLINE_FIXTURES_DIR=fixtures
